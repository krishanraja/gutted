# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CORE_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...

# AI
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Email (Resend)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@gutted.app

# Food API (Edamam)
EDAMAM_APP_ID=your-app-id
EDAMAM_APP_KEY=your-app-key

# Cron (shared secret protecting scheduled routes; sent as the x-internal-secret header)
CRON_SECRET=your-cron-secret

# Attribution (revenue-only emit to the Mindmaker OS warehouse; safe no-op until BOTH are set)
ATTRIBUTION_INGEST_URL=
ATTRIBUTION_INGEST_SECRET=

# App URLs
NEXT_PUBLIC_SITE_URL=https://gutted.app
NEXT_PUBLIC_APP_URL=https://gutted.app
